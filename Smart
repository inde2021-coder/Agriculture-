        mp: { record: "https://uat2.mpbhulekh.gov.in/#/home/bhu-abhilekh" },
        up: { record: "https://upbhulekh.gov.in/public/public_ror/Public_ROR.jsp" },
        bihar: { record: "https://biharbhumi.bihar.gov.in/Biharbhumi/RoR.aspx" },
        cg: { record: "https://bhuiyan.cg.nic.in/User/khasra_vivran.aspx" },
        raj: { record: "https://apnakhata.rajasthan.gov.in/" }
    };

    function openPortalLink(type) {
        let st = document.getElementById('statePortal').value;
        if(st && portals[st] && portals[st][type]) { window.open(portals[st][type], '_blank'); }
    }

    function syncHectareToForm() {
        let h = parseFloat(document.getElementById('quickHectare').value) || 0;
        if(h > 0) {
            let acreVal = (h * 2.47105).toFixed(2);
            document.getElementById('quickResult').innerText = acreVal + " Acre";
            document.getElementById('landArea').value = acreVal;
        } else {
            document.getElementById('quickResult').innerText = "0.00 Acre";
            document.getElementById('landArea').value = "";
        }
    }

    function syncFormToConverter() {
        let a = parseFloat(document.getElementById('landArea').value) || 0;
        if(a > 0) {
            let hectVal = (a / 2.47105).toFixed(2);
            document.getElementById('quickHectare').value = hectVal;
            document.getElementById('quickResult').innerText = a + " Acre";
        } else {
            document.getElementById('quickHectare').value = "";
            document.getElementById('quickResult').innerText = "0.00 Acre";
        }
    }

    function addDays(d, days) { let r = new Date(d); r.setDate(r.getDate() + days); return r; }
    function formatDate(d) { return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }); }

    function calculateSchedule() {
        let areaInput = document.getElementById('landArea').value.trim();
        
        if(!areaInput || parseFloat(areaInput) <= 0) {
            alert("⚠️ कृपया पहले खेती का रकबा (Land Area) दर्ज करें या कनवर्टर का उपयोग करें!");
            document.getElementById('landArea').focus();
            return;
        }

        let acres = parseFloat(areaInput);
        let sDate = document.getElementById('sowingDate').value;
        let dur = parseInt(document.getElementById('cropDuration').value);
        let sDays = parseInt(document.getElementById('sowingDays').value);
        let plot = document.getElementById('plotName').value || "मुख्य धान खेत";

        if(!sDate || !dur || !sDays) { alert("सभी जानकारी सही से भरें!"); return; }

        document.getElementById('displayPlot').innerText = plot;
        document.getElementById('printPlotName').innerText = plot;
        document.getElementById('displayArea').innerText = acres.toFixed(2);

        document.getElementById('calcCost').innerText = Math.round(acres * 20000).toLocaleString('en-IN');
        document.getElementById('calcMaleLab').innerText = Math.round(acres * 5);
        document.getElementById('calcFemaleLab').innerText = Math.round(acres * 15);
        document.getElementById('calcTotalLab').innerText = Math.round(acres * 20);

        let dDAP = Math.round(acres * 40);
        let dMOP = Math.round(acres * 20);
        let dUrea = Math.round(acres * 45);
        let dZinc = Math.round(acres * 10);

        document.getElementById('calcStraw').innerText = (acres * 2.5).toFixed(2);
        document.getElementById('calcCompost').innerText = (acres * 3).toFixed(2);
        document.getElementById('calcDAP').innerText = dDAP;
        document.getElementById('calcMOP').innerText = dMOP;
        document.getElementById('calcUrea1').innerText = Math.round(dUrea/3);
        document.getElementById('calcUrea2').innerText = Math.round(dUrea/3);
        document.getElementById('calcUrea3').innerText = Math.round(dUrea/3);
        document.getElementById('calcZinc').innerText = dZinc;

        document.getElementById('sumDAP').innerText = dDAP;
        document.getElementById('sumMOP').innerText = dMOP;
        document.getElementById('sumUrea').innerText = dUrea;
        document.getElementById('sumZinc').innerText = dZinc;

        let sow = new Date(sDate);
        let trans = addDays(sow, sDays);
        let har = addDays(sow, dur);

        document.getElementById('dtSowing').innerText = formatDate(sow);
        document.getElementById('dtCompost').innerText = formatDate(addDays(sow, -15));
        document.getElementById('dtStraw').innerText = formatDate(addDays(trans, -1));
        document.getElementById('dtTransplant').innerText = formatDate(trans);
        document.getElementById('dtBasal').innerText = formatDate(trans);
        document.getElementById('dtTop1').innerText = formatDate(addDays(trans, 25));
        document.getElementById('dtTop2').innerText = formatDate(addDays(trans, 45));
        document.getElementById('dtStopWater').innerText = formatDate(addDays(har, -7));
        document.getElementById('dtHarvest').innerText = formatDate(har);
        document.getElementById('dtFirstIrr').innerText = formatDate(addDays(trans, 15));

        let c1_irr = addDays(trans, 15);
        let c1_dry = addDays(c1_irr, 5);
        let c1_ref = addDays(c1_irr, 7); 

        let c2_irr = c1_ref;
        let c2_dry = addDays(c2_irr, 8);
        let c2_ref = addDays(c2_irr, 11); 

        let c3_irr = c2_ref;
        let c3_dry = addDays(c3_irr, 10);
        let c3_ref = addDays(c3_irr, 15); 

        let c4_irr = c3_ref;
        let c4_dry = addDays(c4_irr, 8);
        let c4_ref = addDays(c4_irr, 12); 

        document.getElementById('awdTableBody').innerHTML = `
            <tr><td><strong>1</strong></td><td>${formatDate(c1_irr)}</td><td><span class="tag-dose" style="background:#fffbeb; color:#b45309;">5 cm</span></td><td>${formatDate(c1_dry)}</td><td>${formatDate(c1_ref)} (2 दिन बाद)</td></tr>
            <tr><td><strong>2</strong></td><td>${formatDate(c2_irr)}</td><td><span class="tag-dose" style="background:#fffbeb; color:#b45309;">7 cm</span></td><td>${formatDate(c2_dry)}</td><td>${formatDate(c2_ref)} (3 दिन बाद)</td></tr>
            <tr><td><strong>3</strong></td><td>${formatDate(c3_irr)}</td><td><span class="tag-dose" style="background:#fffbeb; color:#b45309;">9 cm</span></td><td>${formatDate(c3_dry)}</td><td>${formatDate(c3_ref)} (5 दिन बाद)</td></tr>
            <tr><td><strong>4</strong></td><td>${formatDate(c4_irr)}</td><td><span class="tag-dose" style="background:#fffbeb; color:#b45309;">8 cm</span></td><td>${formatDate(c4_dry)}</td><td>${formatDate(c4_ref)} (4 दिन बाद)</td></tr>
        `;

        document.getElementById('results').classList.remove('hidden');
    }
