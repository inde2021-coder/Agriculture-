                else if (h > maxDim) { w *= maxDim / h; h = maxDim; }
                canvas.width = w; canvas.height = h;

                ctx.drawImage(img, 0, 0, w, h);
                let imgData = ctx.getImageData(0, 0, w, h);
                let data = imgData.data;
                for (let i = 0; i < data.length; i += 4) {
                    let avg = (data[i] * 0.299 + data[i + 1] * 0.587 + data[i + 2] * 0.114);
                    let enhanced = avg < 125 ? avg * 0.75 : avg * 1.15;
                    enhanced = enhanced > 255 ? 255 : enhanced;
                    data[i] = enhanced; data[i + 1] = enhanced; data[i + 2] = enhanced;
                }
                ctx.putImageData(imgData, 0, 0);

                let optimizedDataUrl = canvas.toDataURL('image/jpeg', 0.98);

                Tesseract.recognize(optimizedDataUrl, 'eng+hin').then(({ data: { text } }) => {
                    callback(null, text.trim().toLowerCase());
                }).catch(err => {
                    callback(err, null);
                });
            };
            img.src = e.target.result;
        };
        reader.readAsDataURL(file);
    }

    function detectDiseaseAndPackage(event) {
        let file = event.target.files[0];
        if (!file) return;
        let status = document.getElementById('diseaseScanStatus');
        let res = document.getElementById('aiPackageResult');
        status.innerHTML = "🧠 न्यूरल OCR इंजन इमेज को प्रोसेस और स्कैन कर रहा है...";
        res.classList.add('hidden');

        preprocessAndRecognize(file, function(err, text) {
            if(err || !text) {
                status.innerHTML = "❌ स्कैन असफल। कृपया सूची से सीधे रोग चुनें।";
                return;
            }
            status.innerHTML = "✅ न्यूरल स्कैन सफल!";
            if(text.includes('blast') || text.includes('tricyclazole') || text.includes('झुलसा')) {
                document.getElementById('manualDiseaseSelect').value = 'blast';
            } else if(text.includes('blb') || text.includes('copper')) {
                document.getElementById('manualDiseaseSelect').value = 'blb';
            } else if(text.includes('borer') || text.includes('fipronil')) {
                document.getElementById('manualDiseaseSelect').value = 'borer';
            } else if(text.includes('hopper') || text.includes('bph')) {
                document.getElementById('manualDiseaseSelect').value = 'bph';
            } else if(text.includes('sheath')) {
                document.getElementById('manualDiseaseSelect').value = 'sheath';
            }
            showManualDiseasePackage();
        });
    }

    function processAdminImage(event) {
        let file = event.target.files[0];
        if (!file) return;
        let status = document.getElementById('adminScanStatus');
        status.innerHTML = "🧠 न्यूरल OCR डेटा स्कैन हो रहा है...";

        preprocessAndRecognize(file, function(err, text) {
            if(err || !text) {
                status.innerHTML = "❌ टेक्स्ट नहीं पढ़ा जा सका।";
                return;
            }
            let lower = text;
            let catId = "drop_blast"; let catName = "रोग: ब्लास्ट";
            if(lower.includes('blb')) { catId = "drop_blb"; catName = "रोग: बीएलबी"; }
            else if(lower.includes('borer')) { catId = "drop_borer"; catName = "कीट: तना छेदक"; }
            else if(lower.includes('bph')) { catId = "drop_bph"; catName = "कीट: माहू"; }
            else if(lower.includes('sheath')) { catId = "drop_sheath"; catName = "रोग: शीथ ब्लास्ट"; }
            else if(lower.includes('weed')) { catId = "drop_weed_pre"; catName = "खरपतवारनाशक"; }

            saveCustomMedicine(catId, catName, "न्यूरल स्कैन: " + text.substring(0, 50));
            status.innerHTML = `✅ सफलता! डेटा <strong>${catName}</strong> में जोड़ दिया गया है।`;
        });
    }

    function saveCustomMedicine(catId, catName, text) {
        let list = JSON.parse(localStorage.getItem('custom_medicines') || '[]');
        list.push({ categoryId: catId, categoryName: catName, text: text });
        localStorage.setItem('custom_medicines', JSON.stringify(list));
        loadSavedMedicines();
    }

    function exportJsonBackup() {
        let data = { medicines: JSON.parse(localStorage.getItem('custom_medicines') || '[]'), app: "AWD Manager Pro", developer: "SHARD PATEL" };
        let blob = new Blob([JSON.stringify(data, null, 2)], {type: "application/json"});
        let link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = "AWD_System_Backup.json";
        link.click();
    }

    function importJsonBackup(event) {
        let file = event.target.files[0];
        if(!file) return;
        let reader = new FileReader();
        reader.onload = function(e) {
            try {
                let json = JSON.parse(e.target.result);
                if(json.medicines) {
                    localStorage.setItem('custom_medicines', JSON.stringify(json.medicines));
                    loadSavedMedicines();
                    alert("बैकअप सफलतापूर्वक रिस्टोर हो गया है!");
                }
            } catch(err) { alert("अमान्य फाइल!"); }
        };
        reader.readAsText(file);
    }

    function exportToExcel() {
        let savedMeds = JSON.parse(localStorage.getItem('custom_medicines') || '[]');
        if(savedMeds.length === 0) { alert("डेटा नहीं है!"); return; }
        let csv = "data:text/csv;charset=utf-8,\uFEFFCategory,Details\r\n";
        savedMeds.forEach(i => { csv += `"${i.categoryName}","${i.text.replace(/"/g, '""')}"\r\n`; });
        let link = document.createElement("a");
        link.href = encodeURI(csv);
        link.download = "AWD_Medicines.csv";
        link.click();
    }

    function addNewMedicine() {
        let catId = document.getElementById('newMedCategory').value;
        let text = document.getElementById('newMedText').value.trim();
        let catObj = document.getElementById('newMedCategory');
        let catName = catObj.options[catObj.selectedIndex].text;
        if(!catId || !text) { alert("कृपया श्रेणी और दवा का नाम दोनों भरें!"); return; }
        saveCustomMedicine(catId, catName, text);
        document.getElementById('newMedText').value = "";
        document.getElementById('newMedCategory').selectedIndex = 0;
        alert("दवा जोड़ दी गई है!");
    }

    function loadSavedMedicines() {
        let list = JSON.parse(localStorage.getItem('custom_medicines') || '[]');
        let tbody = document.getElementById('customMedTableBody');
        if(list.length === 0) { tbody.innerHTML = `<tr><td colspan="2" style="color: #94a3b8;">कोई अतिरिक्त डेटा नहीं।</td></tr>`; return; }
        tbody.innerHTML = "";
        list.forEach(i => {
            let drop = document.getElementById(i.categoryId);
            if(drop) {
                let exists = Array.from(drop.options).some(o => o.text === i.text);
                if(!exists) { let opt = document.createElement('option'); opt.text = i.text; drop.add(opt); }
            }
            tbody.innerHTML += `<tr><td><span class="tag-dose">${i.categoryName}</span></td><td style="text-align:left; padding-left:10px;">${i.text}</td></tr>`;
        });
    }

    function calculatePumpDose() {
        let acres = parseFloat(document.getElementById('calcAcres').value) || 0;
        let med = parseFloat(document.getElementById('totalMedicine').value) || 0;
        let pumps = Math.round(acres * 10);
        let dose = pumps > 0 ? (med / pumps).toFixed(1) : 0;
        document.getElementById('pumpResultText').innerHTML = `👉 ${acres} एकड़ के लिए <strong>${pumps} टंकियां</strong> | प्रति टंकी: <strong>${dose} मिली/ग्राम</strong>`;
    }

    function formatLicenseKey(e) {
        let t = e.target;
        let val = t.value.replace(/[^A-Za-z0-9]/g, '').toUpperCase();
        let f = '';
        for(let i=0; i<val.length; i++) { if(i===6||i===11||i===17) f+='-'; f+=val[i]; }
        t.value = f;
    }

    function verifyKey() {
        let key = document.getElementById('licenseKey').value.trim();
        if (btoa(key) === VALID_KEY_HASH) {
            localStorage.setItem('awd_activation_date', new Date().getTime());
            localStorage.removeItem('awd_install_date');
            alert("सफलतापूर्वक एक्टिवेट हो गया!");
            showMainApp();
        } else { alert("अमान्य की!"); }
    }

